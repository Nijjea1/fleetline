# Data: never commit raw or derived datasets (size + licenses). Scripts recreate them.
data/
*.parquet
*.zip
*.pbf

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Compiled extensions (matcher/cuda/build.sh)
*.so
matcher/cuda/build/
matcher/gpu_smoke/vecadd

# Go
core/bin/

# Node / Next.js
node_modules/
.next/
out/
.vercel/

# Benchmarks: raw run dumps stay local; summarized results/ are committed
bench/**/raw/

# Editors / OS
.DS_Store
.idea/
.vscode/

# Secrets
.env
.env.*
!.env.example

# Terraform
infra/**/.terraform/
*.tfstate
*.tfstate.*

# Offline run outputs: per-trip and per-minute CSVs are large and regenerable;
# summary.json files are small and committed as evidence.
bench/runs/**/trips.csv
bench/runs/**/samples.csv
bench/runs/smoke*/

# run logs
bench/**/*.log
bench/runs/demo/
